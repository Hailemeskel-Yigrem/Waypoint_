# Runtime behavior
NODE_ENV=development
USE_MEMORY_REPOS=true

# Data stores
DATABASE_URL=postgres://waypoint:waypoint@localhost:5432/waypoint
REDIS_URL=redis://localhost:6379

# Development-only secrets; replace these outside local development
JWT_SECRET=waypoint-dev-secret-key
API_KEY_SALT=waypoint-api-salt

# HTTP server and observability
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=true
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=*

# Browser applications
VITE_API_URL=http://localhost:3000

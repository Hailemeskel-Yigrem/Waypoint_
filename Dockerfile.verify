# Runtime verification image using prebuilt API dist (avoids monorepo pnpm install in-container).
FROM node:26-alpine
WORKDIR /app
COPY apps/api/dist ./dist
RUN printf '%s\n' \
  '{' \
  '  "type": "module",' \
  '  "dependencies": {' \
  '    "@fastify/cors": "9.0.1",' \
  '    "@fastify/helmet": "11.1.1",' \
  '    "@fastify/rate-limit": "9.1.0",' \
  '    "fastify": "4.28.1",' \
  '    "fastify-plugin": "4.5.1",' \
  '    "pg": "8.13.1",' \
  '    "pino": "9.5.0",' \
  '    "pino-pretty": "11.3.0",' \
  '    "zod": "3.23.8"' \
  '  }' \
  '}' > package.json \
  && npm install --omit=dev --fetch-retries=5 --fetch-timeout=300000
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "dist/index.js"]

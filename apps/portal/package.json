{
  "name": "@waypoint/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5174",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist",
    "format:check": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@waypoint/shared": "workspace:*",
    "@waypoint/ui": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.0.4",
    "vite": "^4.3.9",
    "vitest": "^0.32.4",
    "@testing-library/react": "^16.1.0",
    "jsdom": "^25.0.1",
    "rimraf": "^6.0.1"
  }
}
